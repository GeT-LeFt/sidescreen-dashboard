{
  "_说明": "旧版 Claude Code 接入示例。请将示例安装目录替换为实际路径，手动合并到用户目录下 .claude/settings.json；不要覆盖已有 hooks。",
  "_为什么安全": [
    "hook.js 将活动写入本地文件。请自行审阅记录字段与现有 hooks 的兼容性。",
    "此文件不是 Codex hooks 配置，Codex 跨设备接入需要独立 supervisor。"
  ],
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "timeout": 10,
            "command": "node \"C:\\path\\to\\sidescreen-dashboard\\hook.js\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "async": true,
            "timeout": 10,
            "command": "node \"C:\\path\\to\\sidescreen-dashboard\\hook.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "async": true,
            "timeout": 10,
            "command": "node \"C:\\path\\to\\sidescreen-dashboard\\hook.js\""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "async": true,
            "timeout": 10,
            "command": "node \"C:\\path\\to\\sidescreen-dashboard\\hook.js\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "timeout": 10,
            "command": "node \"C:\\path\\to\\sidescreen-dashboard\\hook.js\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "timeout": 10,
            "command": "node \"C:\\path\\to\\sidescreen-dashboard\\hook.js\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "timeout": 10,
            "command": "node \"C:\\path\\to\\sidescreen-dashboard\\hook.js\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "timeout": 10,
            "command": "node \"C:\\path\\to\\sidescreen-dashboard\\hook.js\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "timeout": 10,
            "command": "node \"C:\\path\\to\\sidescreen-dashboard\\hook.js\""
          }
        ]
      }
    ]
  }
}
